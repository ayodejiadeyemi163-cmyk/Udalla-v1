# ---------------------------------------------------------------------------
# Udalla environment. Copy to .env.local and fill what you need.
# Never commit a filled file. Every variable is optional for the demo.
# ---------------------------------------------------------------------------

# Public origin used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://udalla.org

# Demo mode. Only the literal string true turns it on. Off by default.
DEMO_MODE=false

# Secret used to sign session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Contact details. These are the production defaults in src/config/brand.ts.
CONTACT_EMAIL=eoisama@gmail.com
CONTACT_PHONE=+1 (713) 887-5886
WHATSAPP_NUMBER=17138875886

# Supabase project. When both URL and anon key exist the Supabase store is used.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used for privileged writes such as audit entries and webhooks.
SUPABASE_SERVICE_ROLE_KEY=

# Private storage bucket that holds customer documents.
SUPABASE_STORAGE_BUCKET=documents

# Paystack. Without these a clearly labelled test payment is offered.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Second gateway slot for the provider abstraction (Stripe shaped).
SECOND_GATEWAY_SECRET_KEY=
SECOND_GATEWAY_WEBHOOK_SECRET=

# Secret required by the reminder cron endpoint. Generate with: openssl rand -hex 32
CRON_SECRET=

# Email delivery. Without a key, emails are logged to the demo outbox.
RESEND_API_KEY=
EMAIL_FROM=notifications@udalla.org

# Rate limit window in seconds and the maximum requests per window.
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=20
